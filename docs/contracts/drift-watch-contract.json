    "cusum_k": 0.5,
    "cusum_h": 4.0,
    "bocpd_hazard_lambda": 50.0,
    "bocpd_changepoint_threshold": 0.5,
    "min_baseline_samples": 5
  },
  "drift_statuses": [
    "HEALTHY",
    "DRIFT_WARNING",
    "REGIME_SHIFT",
    "CRITICAL_DRIFT"
  ],
  "monitored_budgets": [
    "startup_version_p95",
    "binary_size_mb",
    "context_graph_build_cold_p95",
    "runtime_intelligence_eval_p95",
    "ext_cold_load_simple_p95",
    "tool_call_latency_mean"
  ]
