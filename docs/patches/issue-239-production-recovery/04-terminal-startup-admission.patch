+    #[test]
+    fn dropping_uninitialized_ftui_cancels_start_with_buffered_commands() {
+        let (_agent_tx, model) = new_model();
+        let (submit_tx, submit_rx) = mpsc::channel();
+        queue_initial_commands(
+            &submit_tx,
+            true,
+            false,
+            vec![String::from("must not run without a terminal")],
+        )
+        .expect("buffer the CLI startup work");
+        let (ready_tx, ready_rx) = mpsc::channel();
+        let mut model = model.with_submit_channel(submit_tx);
+        model.ui_ready_tx = Some(ready_tx);
+
+        // This is the model ownership path on failed console acquisition or
+        // failed FTUI construction: init was never called, then App is dropped.
+        drop(model);
+        assert!(!await_ftui_start(ready_rx));
+
+        // Channel disconnection does NOT remove the queued commands. This is
+        // why dropping submit_tx alone cannot be the startup cancellation gate.
+        assert!(matches!(
+            submit_rx.try_recv(),
+            Ok(UiCommand::Plan { action }) if action == "enter"
+        ));
+        assert!(matches!(
+            submit_rx.try_recv(),
+            Ok(UiCommand::Prompt(prompt)) if prompt == "must not run without a terminal"
+        ));
+        assert!(matches!(
+            submit_rx.try_recv(),
+            Err(mpsc::TryRecvError::Disconnected)
+        ));
+    }
