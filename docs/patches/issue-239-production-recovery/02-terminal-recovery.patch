+/// A fatal model-side terminal error uses Cmd::quit so FTUI can tear down
+/// normally. Convert that otherwise-successful runtime exit back into the
+/// original failure, retaining any additional runtime/console cleanup error.
+fn finish_terminal_run(
+    app_result: std::io::Result<()>,
+    terminal_failure: &Mutex<Option<std::io::Error>>,
+) -> std::io::Result<()> {
+    let failure = terminal_failure
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .take()
+        .map_or(Ok(()), Err);
+    console_input::combine_results(failure, app_result)
+}
