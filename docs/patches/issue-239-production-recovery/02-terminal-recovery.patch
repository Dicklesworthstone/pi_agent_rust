+/// Complete the synchronous editor handoff. Reacquisition is mandatory even
+/// if release failed partway or the editor could not start. Only a successful
+/// reacquisition permits `Edited` and a return to the input loop.
+fn external_editor_handoff(
+    release: impl FnOnce() -> std::io::Result<()>,
+    edit: impl FnOnce() -> std::io::Result<String>,
+    reacquire: impl FnOnce() -> std::io::Result<(u16, u16)>,
+) -> PiFtuiMsg {
+    let text = release()
+        .and_then(|()| edit())
+        .map_err(|error| format!("external editor: {error}"));
+    match reacquire() {
+        Ok((width, height)) => PiFtuiMsg::Edited {
             text,
             width,
             height,
+        },
+        Err(error) => {
+            let detail = match text {
+                Ok(_) => format!("external editor: terminal not restored: {error}"),
+                Err(edit_error) => format!("{edit_error}; terminal not restored: {error}"),
+            };
+            PiFtuiMsg::TerminalRestoreFailed(std::io::Error::new(error.kind(), detail))
         }
     }
 }
