+    #[test]
+    fn driver_return_notifies_while_an_extension_owns_the_event_sender() {
+        for fail in [false, true] {
+            let (agent_tx, agent_rx) = mpsc::channel();
+            let retained_handler = FtuiExtensionUiHandler::new(agent_tx.clone());
+            let driver = std::thread::spawn(move || -> std::io::Result<()> {
+                let _exit = DriverExitNotice(agent_tx.clone());
+                if fail {
+                    agent_tx
+                        .send(PiMsg::AgentError(String::from("driver failed")))
+                        .expect("connected UI");
+                    return Err(std::io::Error::other("driver failed"));
+                }
+                Ok(())
+            });
+            let result = driver.join().expect("nonpanicking driver");
+            assert_eq!(result.is_err(), fail);
+            if fail {
+                assert!(matches!(agent_rx.try_recv(), Ok(PiMsg::AgentError(_))));
+            }
+            assert!(matches!(agent_rx.try_recv(), Ok(PiMsg::UiShutdown)));
+            // A real handler, not just a bare extra Sender: the handler can
+            // survive through the UI's extension-manager routing reference.
+            assert!(matches!(agent_rx.try_recv(), Err(mpsc::TryRecvError::Empty)));
+            drop(retained_handler);
+            assert!(matches!(
+                agent_rx.try_recv(),
+                Err(mpsc::TryRecvError::Disconnected)
+            ));
+        }
+    }
