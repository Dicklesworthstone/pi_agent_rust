+    #[test]
+    fn driver_exit_ends_the_bridge_and_model_with_live_extension_senders() {
+        let (agent_tx, model) = new_model();
+        let retained_handler = FtuiExtensionUiHandler::new(agent_tx.clone());
+        let source = model
+            .agent_rx
+            .lock()
+            .expect("receiver slot")
+            .take()
+            .expect("one driver stream");
+        agent_tx
+            .send(PiMsg::AgentError(String::from("session initialization failed")))
+            .expect("connected UI");
+        drop(DriverExitNotice(agent_tx));
+        retained_handler
+            .agent_tx
+            .send(PiMsg::System(String::from("late extension callback")))
+            .expect("retained extension can still send");
+
+        let (bridge_tx, bridge_rx) = mpsc::channel();
+        let (done_tx, done_rx) = mpsc::channel();
+        let stop = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let worker_stop = Arc::clone(&stop);
+        let worker = std::thread::spawn(move || {
+            drain_agent_events(
+                &source,
+                |message| bridge_tx.send(message),
+                || worker_stop.load(std::sync::atomic::Ordering::Acquire),
+            );
+            let remaining = source.try_recv();
+            let _ = done_tx.send(());
+            remaining
+        });
+        let finished = done_rx.recv_timeout(Duration::from_secs(2));
+        // A regression that waits for all Sender clones is released before
+        // asserting, so this test cannot leave its bridge thread parked.
+        stop.store(true, std::sync::atomic::Ordering::Release);
+        let remaining = worker.join().expect("bridge worker");
+        finished.expect("UiShutdown must end the bridge while the handler is alive");
+        assert!(matches!(remaining, Ok(PiMsg::System(text)) if text == "late extension callback"));
+
+        let messages: Vec<_> = bridge_rx.try_iter().collect();
+        assert!(matches!(
+            messages.as_slice(),
+            [PiFtuiMsg::Agent(PiMsg::AgentError(_)), PiFtuiMsg::Agent(PiMsg::UiShutdown)]
+        ));
+        let mut sim = ProgramSimulator::new(model);
+        sim.init();
+        for message in messages {
+            sim.send(message);
+        }
+        assert!(!sim.is_running(), "driver loss must stop the UI without a key");
+        assert_eq!(
+            sim.model().error_banner.as_deref(),
+            Some("session initialization failed")
+        );
+        drop(retained_handler);
+    }
