+/// Notify the UI when the driver scope exits, independent of event-sender
+/// lifetime. The UI's command registry can retain an extension manager that
+/// owns an FtuiExtensionUiHandler, whose sender keeps the event stream open.
+/// Waiting for RecvTimeoutError::Disconnected is therefore insufficient.
+///
+/// Install after runtime construction, before session startup: it notifies
+/// before the runtime is dropped, including on an unwinding panic. Aborting
+/// panics terminate the process and do not run Rust destructors.
+#[must_use]
+struct DriverExitNotice(Sender<PiMsg>);
+
+impl Drop for DriverExitNotice {
+    fn drop(&mut self) {
+        // This is the existing unbounded driver-to-bridge channel. Do not
+        // acquire a UI lock or wait for a reply while unwinding the driver.
+        let _ = self.0.send(PiMsg::UiShutdown);
+    }
+}
