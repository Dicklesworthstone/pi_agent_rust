+    fn on_shutdown(&mut self) -> Cmd<PiFtuiMsg> {
+        // Ctrl+C and failed editor recovery are not the only exit paths.
+        // The runtime also shuts down for /exit, Ctrl+D, and terminal errors.
+        // Stop live work before teardown joins the driver, and resolve cards
+        // while their reply channels still exist. Both operations are safe
+        // when an earlier terminal-failure handler already began shutdown.
+        self.pending_quit = true;
